<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PspScript.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotTiled" Version="1.0.0" />
    <PackageReference Include="Parlot" Version="2.3.1" />
    <PackageReference Include="Parlot.SourceGenerator" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="StdLib/**/*.psps" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime/**/*.h" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Makefile" CopyToOutputDirectory="PreserveNewest" />
    <None Include="docker-compose.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
