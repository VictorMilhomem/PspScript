{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PSPScript",
  "scopeName": "source.pspscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#message-handler" },
    { "include": "#lifecycle-hooks" },
    { "include": "#actor-ref-type" },
    { "include": "#literals" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#function-calls" },
    { "include": "#named-args" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.pspscript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.pspscript",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.pspscript" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pspscript",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.pspscript" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.pspscript" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.pspscript",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(actor|state|message|struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.declaration.pspscript" },
            "2": { "name": "entity.name.type.pspscript" }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.pspscript" },
            "2": { "name": "entity.name.function.pspscript" }
          }
        },
        {
          "match": "\\b(asset)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.asset.pspscript" },
            "2": { "name": "variable.other.constant.asset.pspscript" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.const.pspscript" },
            "2": { "name": "variable.other.constant.pspscript" }
          }
        },
        {
          "match": "\\b(game)\\b",
          "name": "storage.type.game.pspscript"
        },
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.pspscript" },
            "2": { "name": "entity.name.namespace.pspscript" }
          }
        },
        {
          "match": "\\b(import)\\b",
          "name": "keyword.control.import.pspscript"
        }
      ]
    },
    "message-handler": {
      "patterns": [
        {
          "match": "\\b(on)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()([A-Za-z_][A-Za-z0-9_]*)(\\))",
          "captures": {
            "1": { "name": "keyword.control.event.pspscript" },
            "2": { "name": "entity.name.type.message.pspscript" },
            "3": { "name": "punctuation.section.parens.begin.pspscript" },
            "4": { "name": "variable.parameter.pspscript" },
            "5": { "name": "punctuation.section.parens.end.pspscript" }
          }
        }
      ]
    },
    "lifecycle-hooks": {
      "patterns": [
        {
          "match": "\\b(init|update|draw|exit)(?=\\s*\\()",
          "name": "entity.name.function.lifecycle.pspscript"
        }
      ]
    },
    "actor-ref-type": {
      "patterns": [
        {
          "match": "\\b(ref)\\s*(<)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(>)",
          "captures": {
            "1": { "name": "support.type.handle.pspscript" },
            "2": { "name": "punctuation.definition.typeparameters.begin.pspscript" },
            "3": { "name": "entity.name.type.actor.pspscript" },
            "4": { "name": "punctuation.definition.typeparameters.end.pspscript" }
          }
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.other.color.rgb-value.pspscript",
          "match": "#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?\\b"
        },
        {
          "name": "constant.numeric.time.pspscript",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:ms|s)\\b"
        },
        {
          "name": "constant.numeric.size.pspscript",
          "match": "\\b[0-9]+(?:MB|KB)\\b"
        },
        {
          "name": "constant.numeric.float.pspscript",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.pspscript",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.language.boolean.pspscript",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.pspscript",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.self.pspscript",
          "match": "\\bself\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.declaration.pspscript",
          "match": "\\b(actor|state|message|struct|enum|fn|asset|const)\\b"
        },
        {
          "name": "storage.modifier.memory.pspscript",
          "match": "\\b(global|level|temp)\\b"
        },
        {
          "name": "storage.type.var.pspscript",
          "match": "\\bvar\\b"
        },
        {
          "name": "keyword.control.flow.pspscript",
          "match": "\\b(if|else|match|for|each|in|break|return|goto)\\b"
        },
        {
          "name": "constant.language.wildcard.pspscript",
          "match": "\\b_\\b(?=\\s*=>)"
        },
        {
          "name": "keyword.control.actor.pspscript",
          "match": "\\b(send|spawn|destroy|on)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.pspscript",
          "match": "\\b(int|u8|u16|u32|f32|bool|void|vec2|vec3|rect|color|timer|ref)\\b"
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.type.pspscript" },
            "2": { "name": "punctuation.accessor.pspscript" },
            "3": { "name": "constant.other.enum.pspscript" }
          }
        },
        {
          "name": "entity.name.type.pspscript",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.pspscript",
          "match": "\\b(sprite|draw_subsprite|draw_tilemap|set_camera|get_camera|set_camera_enabled|draw_rect|draw_text|draw_number|clear_screen|save_game|load_game|play_sound|set_master_volume|stop_all_sounds|button_pressed|button_held|sin|cos|sqrt|abs|floor|min|max|clamp|lerp|print|texture|tilemap|sound|music)(?=\\s*\\()"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.pspscript" },
            "2": { "name": "entity.name.function.method.pspscript" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.pspscript" }
          }
        }
      ]
    },
    "named-args": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "variable.parameter.named.pspscript" },
            "2": { "name": "punctuation.separator.key-value.pspscript" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fat-arrow.pspscript",
          "match": "=>"
        },
        {
          "name": "keyword.operator.arrow.pspscript",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.pspscript",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.assignment.compound.pspscript",
          "match": "(<<=|>>=|\\+=|-=|\\*=|/=|&=|\\|=|\\^=)"
        },
        {
          "name": "keyword.operator.comparison.pspscript",
          "match": "(==|!=|<=|>=)"
        },
        {
          "name": "keyword.operator.logical.pspscript",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.pspscript",
          "match": "(<<|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.comparison.pspscript",
          "match": "(<|>)"
        },
        {
          "name": "keyword.operator.assignment.pspscript",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.pspscript",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    }
  }
}
