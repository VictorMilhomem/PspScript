{
  "Import Module": {
    "prefix": "import",
    "body": [
      "import \"${1:actors/player.psps}\""
    ],
    "description": "Import another PSPScript (.psps) module file"
  },
  "Game Config": {
    "prefix": "game",
    "body": [
      "game \"${1:My PSP Game}\" {",
      "\tid: \"${2:PSPS00001}\",",
      "\tversion: \"${3:01.00}\",",
      "\tram_budget: ${4:16MB},",
      "\tfps: ${5:60},",
      "\tentry: ${6:Gameplay}",
      "}"
    ],
    "description": "Declare a PSPScript v0.2 game configuration block"
  },
  "Compile-Time Constant": {
    "prefix": "const",
    "body": [
      "const ${1:MAX_COUNT} = ${2:32}"
    ],
    "description": "Declare a zero-RAM compile-time constant"
  },
  "Enum Declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:Season} {",
      "\t${2:Spring},",
      "\t${3:Summer},",
      "\t${4:Fall},",
      "\t${5:Winter}",
      "}"
    ],
    "description": "Declare a nominal PSPScript enum"
  },
  "Struct Declaration": {
    "prefix": "struct",
    "body": [
      "struct ${1:Stats} {",
      "\t${2:score}: ${3:int} = ${4:0}",
      "}"
    ],
    "description": "Declare a passive value struct"
  },
  "Match Statement": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:Enum.Variant} => ${3:},",
      "\t_ => $0",
      "}"
    ],
    "description": "Exhaustive match statement over an enum or integer (supports | multi-patterns)"
  },
  "Match Expression": {
    "prefix": "matchexpr",
    "body": [
      "var ${1:result} = match ${2:value} {",
      "\t${3:0} | ${4:1} => ${5:10},",
      "\t_ => ${6:0}",
      "}"
    ],
    "description": "Exhaustive match expression returning a typed value"
  },
  "Range For Loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "\t$0",
      "}"
    ],
    "description": "Exclusive integer range for loop"
  },
  "Inclusive Range For Loop": {
    "prefix": "forinc",
    "body": [
      "for ${1:i} in ${2:0}..=${3:10} {",
      "\t$0",
      "}"
    ],
    "description": "Inclusive integer range for loop (0..=10)"
  },
  "Conditional For Loop": {
    "prefix": "forcond",
    "body": [
      "for ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Go-style conditional for loop"
  },
  "Tilemap Asset": {
    "prefix": "tilemap",
    "body": [
      "asset ${1:level1} = tilemap(\"${2:maps/level1.tmx}\", tileset: ${3:world_sheet})"
    ],
    "description": "Declare a compile-time baked Tiled (.tmx/.tmj) tilemap asset"
  },
  "Sound Asset": {
    "prefix": "sound",
    "body": [
      "asset ${1:sfx_hit} = sound(\"${2:assets/hit.wav}\")"
    ],
    "description": "Declare a compile-time baked WAV sound effect asset"
  },
  "Music Asset": {
    "prefix": "music",
    "body": [
      "asset ${1:theme_bgm} = music(\"${2:assets/theme.wav}\", rate: ${3:22050})"
    ],
    "description": "Declare a compile-time baked looping WAV background music asset"
  },
  "Singleton Actor": {
    "prefix": "actor",
    "body": [
      "actor ${1:Player} {",
      "\tpos: vec2 = { ${2:240.0}, ${3:136.0} }",
      "",
      "\tupdate(dt: f32) {",
      "\t\t$0",
      "\t}",
      "",
      "\tdraw() {",
      "\t\t",
      "\t}",
      "}"
    ],
    "description": "Declare a singleton PSPScript actor"
  },
  "Pooled Actor": {
    "prefix": "actorpool",
    "body": [
      "actor ${1:Enemy}[${2:32}] {",
      "\tpos: vec2",
      "\thp: int = ${3:100}",
      "",
      "\tupdate(dt: f32) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Declare a static-capacity pooled PSPScript actor"
  },
  "Game State": {
    "prefix": "state",
    "body": [
      "state ${1:Gameplay} {",
      "\tinit() {",
      "\t\t$0",
      "\t}",
      "",
      "\tupdate(dt: f32) {",
      "\t\t",
      "\t}",
      "",
      "\tdraw() {",
      "\t\tclear_screen(#000000)",
      "\t}",
      "}"
    ],
    "description": "Declare a PSPScript game state"
  },
  "Message Declaration": {
    "prefix": "message",
    "body": [
      "message ${1:Hit} {",
      "\t${2:amount}: ${3:int}",
      "}"
    ],
    "description": "Declare a typed PSPScript message"
  },
  "Message Handler": {
    "prefix": "on",
    "body": [
      "on ${1:Hit}(${2:msg}) {",
      "\t$0",
      "}"
    ],
    "description": "Add a message handler inside an actor"
  },
  "Pool Iteration (each)": {
    "prefix": "each",
    "body": [
      "each ${1:item} in ${2:Enemy} {",
      "\t$0",
      "}"
    ],
    "description": "Iterate over all active instances in an actor pool"
  },
  "Send Message": {
    "prefix": "send",
    "body": [
      "send(${1:target}, ${2:Hit} { ${3:amount}: ${4:10} })"
    ],
    "description": "Send a typed message to an actor handle"
  },
  "Spawn Actor": {
    "prefix": "spawn",
    "body": [
      "var ${1:e} = spawn ${2:Enemy} { pos: { ${3:100.0}, ${4:100.0} } }"
    ],
    "description": "Spawn a new actor instance from a static pool"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:helper}(${2:a}: ${3:f32}) -> ${4:void} {",
      "\t$0",
      "}"
    ],
    "description": "Declare a PSPScript function"
  },
  "Lambda Expression": {
    "prefix": "lambda",
    "body": [
      "(${1:x}: ${2:f32}) => ${3:x}"
    ],
    "description": "Zero-heap non-capturing arrow lambda expression"
  }
}
