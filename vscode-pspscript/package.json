{
  "name": "pspscript",
  "displayName": "PSPScript",
  "description": "Syntax highlighting, Language Server (LSP) diagnostics & autocomplete, and snippets for PSPScript (.psps) — PlayStation Portable homebrew scripting language.",
  "version": "0.2.0",
  "publisher": "pspscript",
  "icon": "images/icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:pspscript"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "pspscript",
    "psp",
    "playstation portable",
    "homebrew",
    "c99",
    "gamedev"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pspscript",
        "aliases": [
          "PSPScript",
          "pspscript",
          "psps"
        ],
        "extensions": [
          ".psps"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "pspscript",
        "scopeName": "source.pspscript",
        "path": "./syntaxes/pspscript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pspscript",
        "path": "./snippets/pspscript.json"
      }
    ],
    "configuration": {
      "title": "PSPScript",
      "properties": {
        "pspscript.serverPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a compiled PspScript binary or PspScript.dll for the PSPScript Language Server (--lsp). Leave empty to auto-detect from the repository build output."
        }
      }
    }
  }
}
