// StdLib/input.psps

const BTN_CROSS    = 1
const BTN_CIRCLE   = 2
const BTN_SQUARE   = 4
const BTN_TRIANGLE = 8
const BTN_UP       = 16
const BTN_DOWN     = 32
const BTN_LEFT     = 64
const BTN_RIGHT    = 128
const BTN_L        = 256
const BTN_R        = 512
const BTN_START    = 1024
const BTN_SELECT   = 2048

fn dpad_vector() -> vec2 {
    var dir: vec2 = { 0.0, 0.0 }
    if button_held(BTN_LEFT)  { dir.x -= 1.0 }
    if button_held(BTN_RIGHT) { dir.x += 1.0 }
    if button_held(BTN_UP)    { dir.y -= 1.0 }
    if button_held(BTN_DOWN)  { dir.y += 1.0 }
    return dir
}
