// Shared messages, standard input constants, baked SFX, and game state variables
import input

// Compile-time baked WAV sound effects (normalized to mono 44.1 kHz PCM)
asset sfx_chip  = sound("../assets/SFX/Chip.wav")
asset sfx_click = sound("../assets/SFX/Click.wav")
asset sfx_hit   = sound("../assets/SFX/Hit.wav")
asset sfx_score = sound("../assets/SFX/Score.wav")

message PaddleBounce {
    dir_x: f32,
    offset_y: f32
}

message ButtonFocus {
    focused_id: int
}

message ButtonPress {
    confirmed: bool
}

// Persistent globals (saved via save_game() / load_game())
global var player_wins: int = 0
global var last_winner_is_player: bool = true
global var save_loaded: bool = false
global var cpu_difficulty: int = 1 // 0 = EASY, 1 = NORMAL, 2 = HARD

// Level-scoped match state (reset automatically on 'goto')
level var player_score: int = 0
level var cpu_score: int = 0
level var match_active: bool = false
