import "../shared/constants"

state GameOver {
    rematch_timer: timer = 5.0s

    update(dt: f32) {
        if button_pressed(BTN_CROSS) {
            goto Match
        }
        if button_pressed(BTN_CIRCLE) || rematch_timer.elapsed() {
            goto MainMenu
        }
    }

    draw() {
        clear_screen(#070A14)

        if last_winner_is_player {
            draw_text("YOU WIN!", { 176.0, 88.0 }, #00E5FF, 2)
        } else {
            draw_text("CPU WINS!", { 168.0, 88.0 }, #FF2A6D, 2)
        }

        draw_text("TOTAL WINS:", { 184.0, 128.0 }, #FFFFFF, 1)
        draw_number(player_wins, { 280.0, 128.0 }, #FFF275, 1)

        draw_text("X: REMATCH    O: MAIN MENU", { 136.0, 176.0 }, #8899AA, 1)
    }
}
