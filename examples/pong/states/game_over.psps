import "../shared/constants"

state GameOver {
    rematch_timer = 5.0s

    update(dt: f32) {
        if button_pressed(BTN_CROSS) {
            sfx_click.play(0.8)
            goto Match
        }
        if button_pressed(BTN_CIRCLE) {
            sfx_click.play(0.8)
            goto MainMenu
        }
        if rematch_timer.elapsed() {
            goto MainMenu
        }
    }

    draw() {
        clear_screen(#070A14)

        var banner = last_winner_is_player ? "YOU WIN!" : "CPU WINS!"
        var banner_x = last_winner_is_player ? 176.0 : 168.0
        var banner_color = last_winner_is_player ? #00E5FF : #FF2A6D
        draw_text(banner, vec2(banner_x, 88.0), banner_color, 2)

        draw_text("TOTAL WINS:", { 184.0, 128.0 }, #FFFFFF, 1)
        draw_number(player_wins, { 280.0, 128.0 }, #FFF275, 1)

        draw_text("X: REMATCH    O: MAIN MENU", { 136.0, 176.0 }, #8899AA, 1)
    }
}
