import "../shared/constants"

actor Button[MAX_BUTTONS] {
    pos: vec2
    width: int
    height: int
    action_id: int
    selected = false

    on ButtonFocus(msg) {
        selected = (action_id == msg.focused_id)
    }

    on ButtonPress(msg) {
        if !selected || !msg.confirmed {
            return
        }

        match action_id {
            ACT_PLAY => goto Match,
            ACT_DIFFICULTY => {
                cpu_difficulty = cpu_difficulty >= DIFF_HARD ? DIFF_EASY : cpu_difficulty + 1
            },
            ACT_RESET => {
                player_wins = 0
                save_game()
            },
            _ => {}
        }
    }

    draw() {
        var border_color = selected ? #00E5FF : #263859
        var fill_color   = selected ? #142442 : #0D1529
        var text_color   = selected ? #FFFFFF : #8899AA

        // Outer border and inner button panel
        draw_rect(rect(pos.x, pos.y, width, height), border_color)
        draw_rect(rect(pos.x + 2.0, pos.y + 2.0, width - 4, height - 4), fill_color)

        var text_y = pos.y + (height * 0.5) - 4.0

        match action_id {
            ACT_PLAY => draw_text("PLAY MATCH", vec2(pos.x + 60.0, text_y), text_color, 1),
            ACT_DIFFICULTY => {
                var label = match cpu_difficulty {
                    DIFF_EASY => "CPU: EASY",
                    DIFF_NORMAL => "CPU: NORMAL",
                    _ => "CPU: HARD"
                }
                var offset_x = cpu_difficulty == DIFF_NORMAL ? 56.0 : 64.0
                draw_text(label, vec2(pos.x + offset_x, text_y), text_color, 1)
            },
            ACT_RESET => draw_text("RESET WINS", vec2(pos.x + 60.0, text_y), text_color, 1),
            _ => {}
        }
    }
}
