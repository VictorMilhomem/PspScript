import "../shared/assets"
import "../actors/showcase_sprite"

state Gallery {
    init() {
        set_camera({ 0.0, 0.0 })
        spawn Egg { pos: { 120.0, 128.0 }, bob_phase: 0.0 }
        spawn Egg { pos: { 160.0, 168.0 }, bob_phase: 1.2 }
        spawn Egg { pos: { 304.0, 168.0 }, bob_phase: 2.4 }
        spawn Egg { pos: { 344.0, 128.0 }, bob_phase: 3.6 }
    }

    update(dt: f32) {
        if button_pressed(BTN_CROSS) {
            send(ChickenHouse, CycleTint { step: 1 })
        }
    }

    draw() {
        clear_screen(#1E3323)

        // Screen-space HUD (camera disabled)
        set_camera_enabled(false)
        draw_rect({ 0.0, 0.0, 480.0, 26.0 }, #0D1810)
        draw_text("PSPSCRIPT SPRITE DEMO", { 12.0, 9.0 }, #FFF275, 1)
        draw_text("D-PAD: MOVE   X: TINT", { 296.0, 9.0 }, #A8C6A8, 1)

        draw_rect({ 0.0, 248.0, 480.0, 24.0 }, #0D1810)
        draw_text("BAKED PNGS: FREE_CHICKEN_HOUSE.PNG + EGG_ITEM.PNG", { 44.0, 256.0 }, #FFFFFF, 1)
    }

    exit() {
        each egg in Egg {
            destroy egg
        }
    }
}
