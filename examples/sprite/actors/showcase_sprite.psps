import "../shared/assets"

actor ChickenHouse {
    pos = vec2(216.0, 112.0)
    speed = 140.0
    tint = #FFFFFF

    on CycleTint(msg) {
        active_tint_index += msg.step
        if active_tint_index > 3 {
            active_tint_index = 0
        }

        tint = match active_tint_index {
            0 => #FFFFFF,
            1 => #00E5FF,
            2 => #FFF275,
            _ => #FF6B9D
        }
    }

    update(dt: f32) {
        temp var dir: vec2 = dpad_vector()

        if dir.length() > 0.0 {
            pos += dir.normalized() * speed * dt
        }

        pos.x = clamp(pos.x, 16.0, 416.0)
        pos.y = clamp(pos.y, 40.0, 196.0)
    }

    draw() {
        set_camera_enabled(true)
        sprite(house_tex, pos, tint)
    }
}

actor Egg[8] {
    pos: vec2
    bob_phase = 0.0
    base_y = 120.0

    init() {
        base_y = pos.y
    }

    update(dt: f32) {
        bob_phase += dt * 4.0
        pos.y = base_y + sin(bob_phase) * 4.0
    }

    draw() {
        set_camera_enabled(true)
        sprite(egg_tex, pos, #FFFFFF)
    }
}
